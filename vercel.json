{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.md",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/about.md",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/android-repair.md",
      "destination": "/android-repair",
      "statusCode": 301
    },
    {
      "source": "/contact.md",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/iphone-repair.md",
      "destination": "/iphone-repair",
      "statusCode": 301
    },
    {
      "source": "/laptop-repair.md",
      "destination": "/laptop-repair",
      "statusCode": 301
    },
    {
      "source": "/macbook-repair.md",
      "destination": "/macbook-repair",
      "statusCode": 301
    },
    {
      "source": "/mail-in-repair.md",
      "destination": "/mail-in-repair",
      "statusCode": 301
    },
    {
      "source": "/pricing.md",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/repair-sos.md",
      "destination": "/repair-sos",
      "statusCode": 301
    },
    {
      "source": "/warranty.md",
      "destination": "/warranty",
      "statusCode": 301
    },
    {
      "source": "/student-military",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/guide",
      "destination": "/tips",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/laptop-repair-wood-river-valley",
      "destination": "/laptop-repair",
      "statusCode": 301
    },
    {
      "source": "/tips/android-wont-charge",
      "destination": "/tips/phone-charges-slowly",
      "statusCode": 301
    },
    {
      "source": "/tips/mac-running-slow",
      "destination": "/tips/speed-up-slow-laptop",
      "statusCode": 301
    },
    {
      "source": "/tips/dropped-phone-wont-respond",
      "destination": "/tips/phone-screen-black-but-on",
      "statusCode": 301
    },
    {
      "source": "/guides/data-recovery-what-to-expect",
      "destination": "/data-recovery",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|mjs|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|ico|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
